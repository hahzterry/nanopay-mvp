# Required
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
WALLET_SET_ID=
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional Gateway settings
# Enable experimental Gateway balance lookup. If disabled or unavailable,
# the API falls back to direct Arc balance and returns gatewayEnabled=false.
ENABLE_GATEWAY_EXPERIMENTAL=false
GATEWAY_API_BASE=https://gateway-api-testnet.circle.com

# Optional / currently documentation-dependent Gateway deposit values
# Enable only after confirming current Circle Gateway contract interfaces.
ENABLE_GATEWAY_DEPOSIT=false
GATEWAY_WALLET_ADDRESS=
GATEWAY_MINTER_ADDRESS=
